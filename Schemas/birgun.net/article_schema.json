{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/birgun-article-extraction.json",
  "title": "BirgunArticle",
  "description": "Formal schema for extracted Birgun.net article (metadata + body blocks).",
  "type": "object",
  "required": ["metadata", "body"],
  "additionalProperties": false,
  "properties": {
    "metadata": {
      "type": "object",
      "title": "BirgunMetadata",
      "required": ["title", "published_at"],
      "additionalProperties": false,
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "published_at": { "type": "string", "format": "date-time" },
        "modified_at": { "type": ["string", "null"], "format": "date-time" },
        "author": { "type": ["string", "null"] },
        "section": { "type": ["string", "null"] },
        "keywords": { "type": ["array", "null"], "items": { "type": "string" } }
      }
    },
    "body": {
      "type": "object",
      "required": ["blocks"],
      "additionalProperties": false,
      "properties": {
        "blocks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["type"],
            "properties": {
              "type": {
                "enum": ["heading", "paragraph", "image", "blockquote", "list", "table", "horizontal_rule"]
              },
              "content": { "type": "string" },
              "level": { "type": "integer", "minimum": 1, "maximum": 6 },
              "src": { "type": "string" },
              "alt": { "type": ["string", "null"] },
              "ordered": { "type": "boolean" },
              "items": { "type": "array", "items": { "type": "string" } },
              "headers": { "type": "array", "items": { "type": "string" } },
              "rows": { "type": "array", "items": { "type": "array", "items": { "type": "string" } } }
            }
          }
        }
      }
    }
  }
}
